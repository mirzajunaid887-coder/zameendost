# Frontend (build-time, PUBLIC values only — never put secrets here)
# Leave empty to call Open-Meteo directly from the browser; set to your Worker URL to use the shared cache.
VITE_API_BASE=
# Worker secrets are NOT stored in files. Set them with:  wrangler secret put JWT_SECRET
# Local worker development only: copy to worker/.dev.vars (git-ignored)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
